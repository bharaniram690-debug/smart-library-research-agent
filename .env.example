# Google Gemini API Key (Required for AI paper summarization)
# Obtain your API key from Google AI Studio: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Semantic Scholar API Key (Semantic Scholar is free without key, but key gives higher rate limits)
# Obtain from: https://www.semanticscholar.org/product/api
SEMANTIC_SCHOLAR_API_KEY=your_optional_semantic_scholar_api_key_here

# Gemini Model selection (defaults to gemini-3.8-flash)
# Supported options: gemini-3.8-flash, gemini-3.8-pro, gemini-3.5-flash, gemini-2.5-flash
GEMINI_MODEL=gemini-3.5-flash
